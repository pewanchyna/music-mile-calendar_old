# Eventbrite API Configuration
# Get your personal access token from: https://www.eventbrite.com/api/
# Leave blank if you don't want to fetch Eventbrite events
EVENTBRITE_API_KEY=

# Bandsintown API
# Public API - no key needed, but you can register an app for tracking
BANDSINTOWN_APP_ID=music_mile_calendar

# Email for notifications (optional)
# Could be used for error alerts
NOTIFICATION_EMAIL=

# Deployment Configuration
NODE_ENV=production
